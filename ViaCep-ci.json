{
  "info": {
    "_postman_id": "ce90315b-4782-411e-bc45-2f8383712ccb",
    "name": "Via Cep",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "52626574",
    "_collection_link": "https://go.postman.co/collection/52626574-ce90315b-4782-411e-bc45-2f8383712ccb?source=collection_link"
  },
  "item": [
    {
      "name": "Listar dados",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Valida se o status retornado é 200",
              "pm.test(\"O status retornado é 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Captura o CEP enviado na URL (variável ZipCode)",
              "const zipCodeRaw = String(pm.variables.get(\"ZipCode\")).padStart(8, \"0\");",
              "const cepEsperado = zipCodeRaw.slice(0, 5) + \"-\" + zipCodeRaw.slice(5);",
              "console.log(\"CEP esperado:\", cepEsperado);",
              "",
              "// Só executa validações de JSON se a resposta for bem-sucedida e contiver JSON",
              "if (pm.response && pm.response.code === 200 && pm.response.headers.get(\"content-type\").includes(\"json\")) {",
              "    ",
              "    // 2. Valida se o CEP retornado é igual ao CEP consultado",
              "    pm.test(\"CEP retornado igual ao CEP da URL\", function () {",
              "        const respostaJson = pm.response.json();",
              "        pm.expect(respostaJson.cep).to.eql(cepEsperado);",
              "    });",
              "",
              "    console.log(\"Resposta da API:\", pm.response.json().cep);",
              "",
              "    // 3. Definir o Schema (O Contrato que a API prometev seguir)",
              "    const schemaCadastro = {",
              "        \"type\": \"object\",",
              "        \"required\": [\"cep\", \"logradouro\", \"complemento\", \"unidade\", \"bairro\", \"localidade\", \"uf\", \"estado\", \"regiao\", \"ibge\", \"gia\", \"ddd\", \"siafi\"],",
              "        \"properties\": {",
              "            \"cep\": { \"type\": \"string\" },",
              "            \"logradouro\": { \"type\": \"string\" },",
              "            \"complemento\": { \"type\": \"string\" },",
              "            \"unidade\": { \"type\": \"string\" },",
              "            \"bairro\": { \"type\": \"string\" },",
              "            \"localidade\": { \"type\": \"string\" },",
              "            \"uf\": { \"type\": \"string\" },",
              "            \"estado\": { \"type\": \"string\" },",
              "            \"regiao\": { \"type\": \"string\" },",
              "            \"ibge\": { \"type\": \"string\" },",
              "            \"gia\": { \"type\": \"string\" },",
              "            \"ddd\": { \"type\": \"string\" },",
              "            \"siafi\": { \"type\": \"string\" }",
              "        }",
              "    };",
              "",
              "    const Ajv = require('ajv');",
              "    const ajv = new Ajv();",
              "",
              "    pm.test(\"Contrato do JSON Schema está correto\", function () {",
              "        var respostaJson = pm.response.json();",
              "        pm.expect(ajv.validate(respostaJson, schemaCadastro)).to.be.true;",
              "    });",
              "} else {",
              "    console.log(\"Pulando testes de JSON: Resposta inválida ou erro HTML recebido.\");",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function zipCode() {",
              "    const zipCode = [",
              "        \"69900436\",",
              "        \"57070482\",",
              "        \"69094270\",",
              "        \"68908093\",",
              "        \"45204115\",",
              "        \"63115210\",",
              "        \"72410520\",",
              "        \"29176817\",",
              "        \"75900526\",",
              "        \"65066943\",",
              "        \"37955190\",",
              "        \"79750120\",",
              "        \"78716599\",",
              "        \"68455694\",",
              "        \"58806110\",",
              "        \"55605300\",",
              "        \"64207728\",",
              "        \"85760336\",",
              "        \"27521140\",",
              "        \"59640438\",",
              "        \"76803678\",",
              "        \"69304530\",",
              "        \"98785436\",",
              "        \"88900012\",",
              "        \"49105058\",",
              "        \"04351060\",",
              "        \"77510100\"",
              "    ];",
              "    var randomItem = zipCode[Math.floor(Math.random() * zipCode.length)];",
              "    return randomItem;",
              "}",
              "pm.variables.set(\"ZipCode\", zipCode());"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{url}}/ws/{{ZipCode}}/json",
          "host": [
            "{{url}}"
          ],
          "path": [
            "{{ZipCode}}",
            "json"
          ]
        }
      },
      "response": []
    }
  ]
}